{
  "name": "reflection-lense-ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm theme && pnpm --filter @reflection/react dev",
    "lab": "pnpm theme && pnpm --filter @reflection/theme-lab dev",
    "theme": "pnpm --filter @reflection/theme build",
    "build": "pnpm -r build",
    "build-storybook": "pnpm theme && pnpm --filter @reflection/react build-storybook",
    "build:site": "pnpm theme && pnpm --filter @reflection/theme-lab build && pnpm --filter @reflection/react build-storybook && node scripts/build-site.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm theme && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
